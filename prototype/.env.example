# Copier ce fichier en ".env" et remplir selon le provider choisi.

# --- Provider "anthropic" ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Provider "gemini" (gratuit — cle sur https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Provider "ollama" ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
